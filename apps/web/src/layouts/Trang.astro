---
// Khung chung: <head> theo ECOSYSTEM_IDENTITY mục 2.2, đầu trang, chân trang nối về tsudev.com (mục 4).
import '../styles/fonts.css';
import '../styles/fonts-mono.css';
import '../styles/fonts-display.css';
// Lớp nền chung + lớp bản sắc sounddb (tsudev-standards v5.0.0, DESIGN_SYSTEM 1.2.1) - KHÔNG chép mã màu vào CSS riêng.
import '../../../../.standards/tokens/tokens.css';
import '../../../../.standards/tokens/products.css';
import '../styles/tokens.css';
import '../styles/site.css';
import { LANGS, duongDan as dd, t, type Lang } from '../i18n';
import { REPO_URL, SAN_PHAM, SITE } from '../lib/site';

interface Props {
  lang: Lang;
  tieuDe?: string;
  moTa: string;
  /** Đường dẫn dạng tiếng Việt (`/do/`); bản `/en/` tự suy ra. */
  duongDan: string;
  anChiMuc?: boolean;
  /** Trang không có bản tương ứng ở ngôn ngữ kia (404) ⇒ không hreflang, lang.js không chuyển. */
  motNgonNgu?: boolean;
}
const { lang, tieuDe, moTa, duongDan, anChiMuc = false, motNgonNgu = false } = Astro.props;
const d = t(lang);
const k = d.khung;
const title = tieuDe ? `${tieuDe} - ${SAN_PHAM} | TsuDEV` : `${SAN_PHAM} | TsuDEV`;
const url = `${SITE}${dd(lang, duongDan)}`;
const nam = new Date().getFullYear();
const menu = [
  { href: '/do/', ten: k.menu.do },
  { href: '/huong-dan/', ten: k.menu.huongDan },
  { href: '/bao-mat/', ten: k.menu.baoMat },
  { href: '/bang-dieu-khien/', ten: k.menu.taiKhoan },
];
const cheDo = [
  { ma: 'light', ten: k.cheDo.light, icon: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/>' },
  { ma: 'dark', ten: k.cheDo.dark, icon: '<path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a6.8 6.8 0 0 0 10.8 10.8Z"/>' },
  { ma: 'system', ten: k.cheDo.system, icon: '<rect x="2.8" y="4.4" width="18.4" height="12.2" rx="1.6"/><path d="M8.6 20.2h6.8M12 16.6v3.6"/>' },
];
const dangO = (href: string) => duongDan.startsWith(href);
import DauTsuDev from '../components/DauTsuDev.astro';
---
<!doctype html>
<html lang={lang} data-theme="dark" data-product="sounddb" data-mot-ngon-ngu={motNgonNgu ? '' : undefined}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={moTa}>
    <meta name="theme-color" content="#0a0a0a">
    <meta name="color-scheme" content="dark light">
    <script is:inline src="/theme.js"></script>
    <script is:inline src="/lang.js"></script>
    {anChiMuc && <meta name="robots" content="noindex">}
    <link rel="canonical" href={url}>
    {!motNgonNgu && LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${SITE}${dd(l, duongDan)}`}>)}
    {!motNgonNgu && <link rel="alternate" hreflang="x-default" href={`${SITE}${duongDan}`}>}
    <meta property="og:site_name" content="TsuDEV">
    <meta property="og:type" content="website">
    <meta property="og:locale" content={d.meta.ogLocale}>
    <meta property="og:title" content={tieuDe ? `${tieuDe} - ${SAN_PHAM}` : SAN_PHAM}>
    <meta property="og:description" content={moTa}>
    <meta property="og:image" content={`${SITE}/og-image.png`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={url}>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico" sizes="32x32"><!-- không "any": Chrome sẽ bỏ favicon.svg -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
  </head>
  <body data-platform="web">
    <a class="bo-qua" href="#noi-dung">{k.boQua}</a>
    <header class="dau-trang">
      <div class="khung dau-trang__trong">
        <a class="thuong-hieu" href={dd(lang, '/')} aria-label={k.trangChu}>
          <!-- LG2: logo vector xoá nền, hai bản theo data-theme (site.css ẩn bản không hợp) - không còn ô nền tối. -->
          <picture class="logo-toi"><source srcset="/brand/logo-sound-db-48.avif 1x, /brand/logo-sound-db-96.avif 2x" type="image/avif"><source srcset="/brand/logo-sound-db-48.webp 1x, /brand/logo-sound-db-96.webp 2x" type="image/webp"><img src="/brand/logo-sound-db.png" alt="" width="36" height="36"></picture>
          <picture class="logo-sang"><source srcset="/brand/logo-sound-db-light-48.avif 1x, /brand/logo-sound-db-light-96.avif 2x" type="image/avif"><source srcset="/brand/logo-sound-db-light-48.webp 1x, /brand/logo-sound-db-light-96.webp 2x" type="image/webp"><img src="/brand/logo-sound-db-light.png" alt="" width="36" height="36"></picture>
          <span>Sound Db</span>
        </a>
        <nav aria-label={k.menuChinh}>
          <ul class="menu">
            {menu.map((m) => <li><a href={dd(lang, m.href)} aria-current={dangO(m.href) ? 'page' : undefined}>{m.ten}</a></li>)}
          </ul>
        </nav>
        <div class="dau-trang__nut">
          <a class="nut nut--phu nut--nho" href={REPO_URL} target="_blank" rel="noopener noreferrer">{k.maNguon}</a>
          <a class="nut nut--chinh nut--nho" href={dd(lang, '/tai-ve/')} aria-current={dangO('/tai-ve/') ? 'page' : undefined}>{k.taiVe}</a>
        </div>
      </div>
    </header>
    <main id="noi-dung">
      <slot />
    </main>
    <footer class="chan-trang">
      <div class="khung">
        <div class="chan-trang__trong">
          <div>
            <a class="thuong-hieu thuong-hieu--nho" href="https://tsudev.com" target="_blank" rel="noopener noreferrer">
              <picture><source srcset="/brand/logo-tsudev-48.avif 1x, /brand/logo-tsudev-96.avif 2x" type="image/avif"><source srcset="/brand/logo-tsudev-48.webp 1x, /brand/logo-tsudev-96.webp 2x" type="image/webp"><img src="/brand/logo-tsudev-256.png" alt="" width="28" height="28" loading="lazy" decoding="async"></picture>
              <span>TsuDEV</span>
            </a>
            <p set:html={k.gioiThieu} />
          </div>
          <nav aria-label={k.heSinhThai}>
            <ul class="chan-trang__lien-ket">
              <li><a href="https://tsudev.com/terms" target="_blank" rel="noopener noreferrer"><DauTsuDev />{k.dieuKhoan}</a></li>
              <li><a href="https://tsudev.com/privacy" target="_blank" rel="noopener noreferrer"><DauTsuDev />{k.riengTu}</a></li>
              <li><a href="https://tsudev.com/projects" target="_blank" rel="noopener noreferrer"><DauTsuDev />{k.sanPhamKhac}</a></li>
            </ul>
          </nav>
          <nav aria-label={k.duAn}>
            <ul class="chan-trang__lien-ket">
              <li><a href={dd(lang, '/tai-ve/')}>{k.taiVe}</a></li>
              <li><a href={dd(lang, '/bao-mat/')}>{k.baoMatRiengTu}</a></li>
              <li><a href={dd(lang, '/security/')}>{k.baoMatTinCay}</a></li>
              <li><a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">{k.baoLoi}</a></li>
            </ul>
          </nav>
        </div>
        <div class="chan-trang__cuoi">
          <p>© {nam} TsuDEV</p>
          {!motNgonNgu && (
            <nav class="ngon-ngu" aria-label={k.ngonNgu}>
              {LANGS.map((l) => (
                <a href={dd(l, duongDan)} hreflang={l} lang={l} data-chon-ngon-ngu={l} aria-current={l === lang ? 'true' : undefined}>{t(l).meta.ten}</a>
              ))}
            </nav>
          )}
          <div class="giao-dien" id="giao-dien" role="radiogroup" aria-label={k.giaoDien} hidden>
            {cheDo.map((c) => (
              <button type="button" role="radio" aria-checked={c.ma === 'dark' ? 'true' : 'false'} tabindex={c.ma === 'dark' ? '0' : '-1'}
                      aria-label={c.ten} title={c.ten} data-chon-giao-dien={c.ma}>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={c.icon} />
              </button>
            ))}
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
