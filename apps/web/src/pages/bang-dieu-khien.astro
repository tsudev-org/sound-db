---
import Trang from '../layouts/Trang.astro';
---
<Trang tieuDe="Tài khoản" moTa="Bảng điều khiển Sound Db: xem lịch sử đo đã đồng bộ, quản lý và thu hồi thiết bị, tải về hoặc xóa toàn bộ dữ liệu của tài khoản tsudev." duongDan="/bang-dieu-khien/" anChiMuc>
  <div class="khung van-ban" id="bang">
    <h1>Tài khoản Sound Db</h1>
    <p id="trang-thai" role="status">Đang tải...</p>
    <div id="chua-dang-nhap" hidden>
      <p>Bạn chưa đăng nhập.</p>
      <p><a class="nut nut--chinh" href="/dang-nhap/">Đăng nhập</a></p>
    </div>
    <div id="da-dang-nhap" hidden>
      <p><strong id="ten"></strong> · <span id="email"></span></p>
      <p id="thong-ke"></p>
      <p class="hang-nut">
        <button id="nut-xuat" class="nut nut--phu nut--nho" type="button">Tải toàn bộ dữ liệu (JSON)</button>
        <button id="nut-dang-xuat" class="nut nut--phu nut--nho" type="button">Đăng xuất</button>
      </p>

      <h2>Phiên đo</h2>
      <p><label class="an-di" for="tim">Tìm theo tên phiên</label>
        <input id="tim" class="o-tim" type="search" placeholder="Tìm theo tên phiên" maxlength="100"></p>
      <div class="vung-ban-ghi">
        <table class="bang">
          <thead><tr><th scope="col">Tên</th><th scope="col">Bắt đầu</th><th scope="col" class="so">Thời lượng</th><th scope="col" class="so">LAeq</th><th scope="col" class="so">LAFmax</th><th scope="col"><span class="an-di">Thao tác</span></th></tr></thead>
          <tbody id="dong-phien"></tbody>
        </table>
        <div class="chan-ban-ghi">
          <label class="an-di" for="so-dong">Số bản ghi mỗi trang</label>
          <select id="so-dong">
            <option>10</option><option>20</option><option>50</option><option>100</option><option>200</option>
          </select>
          <span class="mo">/ trang</span>
          <span class="mo giua" id="tom-tat">0-0 / 0</span>
          <button id="truoc" class="nut nut--phu nut--nho" type="button" aria-label="Trang trước">‹</button>
          <span class="mo" id="so-trang">1 / 1</span>
          <button id="sau" class="nut nut--phu nut--nho" type="button" aria-label="Trang sau">›</button>
        </div>
      </div>

      <h2>Thiết bị đã đăng nhập</h2>
      <table class="bang">
        <thead><tr><th scope="col">Thiết bị</th><th scope="col">Nền tảng</th><th scope="col">Lần cuối</th><th scope="col"><span class="an-di">Thao tác</span></th></tr></thead>
        <tbody id="dong-thiet-bi"></tbody>
      </table>

      <h2>Hoạt động bảo mật gần đây</h2>
      <table class="bang">
        <thead><tr><th scope="col">Sự kiện</th><th scope="col">Lúc</th></tr></thead>
        <tbody id="dong-hoat-dong"></tbody>
      </table>

      <h2>Xóa dữ liệu</h2>
      <p>Xóa vĩnh viễn mọi phiên đo, hồ sơ hiệu chuẩn và thiết bị của bạn trên máy chủ Sound Db. Tài khoản tsudev không bị ảnh hưởng.</p>
      <p><button id="nut-xoa" class="nut nut--nguy nut--nho" type="button">Xóa toàn bộ dữ liệu Sound Db</button></p>
    </div>
  </div>
  <script src="../scripts/bang-dieu-khien.ts"></script>
</Trang>
