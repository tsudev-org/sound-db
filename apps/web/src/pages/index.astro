---
import Trang from '../layouts/Trang.astro';

const tinhNang = [
  ['Máy đo mức âm', 'Trọng số A, C, Z và thời gian Nhanh/Chậm/Xung cùng lúc. Leq, Lmax, Lmin, Lpeak, LAF10/50/90, SEL.'],
  ['Phổ tần số FFT', 'FFT tới 32768 điểm trong ứng dụng (8192 trên web), 5 loại cửa sổ, giữ đỉnh, con trỏ đọc tần số. Tần số trội sai số dưới 1% bin.'],
  ['Phổ đồ', 'Thác nước theo thời gian trên trục tần số log, nhận ra tiếng vo ve, tiếng rít, tần số lạ.'],
  ['Dải octave 1/1 và 1/3', 'Dải cơ số 10 theo IEC 61260-1, tên dải danh định từ 16 Hz tới 20 kHz.'],
  ['Cao độ và nốt nhạc', 'Thuật toán McLeod: sai số dưới 1 cent, hiện nốt, lệch cent, chỉnh được A4.'],
  ['Liều tiếp xúc tiếng ồn', 'Tính theo NIOSH (85 dBA, 3 dB) và OSHA (90 dBA, 5 dB), kèm mức trung bình 8 giờ.'],
  ['Bộ phát tín hiệu', 'Sin, vuông, răng cưa, tam giác, ồn trắng, ồn hồng, quét tần số log 20 Hz - 20 kHz.'],
  ['Hiệu chuẩn', 'Theo máy hiệu chuẩn 94/114 dB, theo máy đo chuẩn, hoặc nhập offset; hồ sơ đồng bộ theo tài khoản.'],
  ['Đồng bộ đa thiết bị', 'Đăng nhập tài khoản tsudev để có lịch sử đo trên điện thoại, máy tính và web. Không bắt buộc.'],
];
---
<Trang moTa="Sound Db: máy đo âm thanh chính xác cho Android, iOS, Windows, macOS, Linux và web. Đo dB, phổ tần số, octave, cao độ, liều tiếng ồn." duongDan="/">
  <section class="hero khung">
    <span class="nhan">Một sản phẩm của tsudev</span>
    <h1>Đo âm thanh <span class="nhan-mau">chính xác</span>, trên mọi thiết bị</h1>
    <p>Sound Db đo mức âm, phổ tần số, dải octave và cao độ ngay trên thiết bị của bạn. Âm thanh không bao giờ rời
      máy; chỉ con số đo được mới đồng bộ khi bạn đăng nhập.</p>
    <div class="hang-nut">
      <a class="nut nut--chinh" href="/do/">Đo ngay trên trình duyệt</a>
      <a class="nut nut--phu" href="/tai-ve/">Tải ứng dụng</a>
    </div>
  </section>

  <section class="muc">
    <div class="khung">
      <h2>Bộ công cụ đo đầy đủ</h2>
      <p class="dan">Một lõi xử lý tín hiệu viết bằng Rust, chạy giống hệt nhau trên web (WebAssembly) và được kiểm
        khớp từng con số với bản trong ứng dụng.</p>
      <div class="luoi">
        {tinhNang.map(([ten, moTa]) => <div class="the"><h3>{ten}</h3><p>{moTa}</p></div>)}
      </div>
    </div>
  </section>

  <section class="muc">
    <div class="khung">
      <h2>Độ chính xác có kiểm chứng</h2>
      <p class="dan">Bộ lọc trọng số bám đường chuẩn IEC 61672-1 với sai lệch dưới 0,05 dB tới 12,5 kHz (dung sai
        cấp 1 của chuẩn là ±1 dB trở lên). Trọng số thời gian, phân vị và liều tiếp xúc có bộ test tự động riêng.
        Micro điện thoại không phải micro đo lường: hãy hiệu chuẩn để sai số tổng còn vài phần mười dB.</p>
      <div class="luoi">
        <div class="the"><h3>Không xử lý ngầm</h3><p>Tắt tự động tăng âm, khử vọng, khử ồn của hệ điều hành; Android dùng nguồn thu chưa xử lý.</p></div>
        <div class="the"><h3>Mã nguồn mở</h3><p>Ai cũng xem và chạy lại được bộ test độ chính xác. Giấy phép Apache 2.0.</p></div>
        <div class="the"><h3>Bảo mật mặc định</h3><p>Đăng nhập qua trình duyệt hệ thống với PKCE, token trong kho bí mật của hệ điều hành.</p></div>
      </div>
    </div>
  </section>
</Trang>
