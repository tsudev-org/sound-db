---
import Trang from '../layouts/Trang.astro';
import { PHIEN_BAN, REPO_URL } from '../lib/site';

const nenTang = [
  ['Windows', 'Windows 10/11 x64', 'Tệp .zip, giải nén rồi chạy sound_db.exe'],
  ['macOS', 'macOS 12 trở lên (Intel và Apple Silicon)', 'Tệp .zip chứa Sound Db.app (chưa ký Apple: chuột phải > Mở)'],
  ['Linux', 'x64', 'Tệp .tar.gz, giải nén rồi chạy ./sound_db'],
  ['Android', 'Android 7.0 trở lên', 'APK ký số - sắp có'],
  ['iOS và iPadOS', 'iOS 15 trở lên', 'App Store - đang chuẩn bị'],
];
---
<Trang tieuDe="Tải về" moTa="Tải Sound Db cho Android, iOS, Windows, macOS và Linux. Mỗi tệp cài đều công bố SHA-256 để bạn tự kiểm chứng trước khi cài đặt." duongDan="/tai-ve/">
  <div class="khung van-ban">
    <h1>Tải về Sound Db</h1>
    <p>Bản mới nhất: <strong>{PHIEN_BAN}</strong>. Mọi bản được dựng tự động trên GitHub Actions từ mã nguồn công khai,
      kèm SHA-256 và chứng thực nguồn gốc. Không muốn cài đặt? <a href="/do/">Đo ngay trên trình duyệt</a>.</p>
    <table class="bang">
      <thead><tr><th scope="col">Nền tảng</th><th scope="col">Yêu cầu</th><th scope="col">Kênh</th></tr></thead>
      <tbody>{nenTang.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
    <p><a class="nut nut--chinh" href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer">Mở trang phát hành</a></p>
    <h2>Kiểm chứng tệp tải về</h2>
    <p>Mỗi bản phát hành kèm tệp <code>SHA256SUMS</code>. So khớp trước khi cài:</p>
    <pre tabindex="0" aria-label="Lệnh kiểm chứng tệp tải về"><code>sha256sum -c SHA256SUMS --ignore-missing
gh attestation verify sound-db_{PHIEN_BAN}_x64-linux.tar.gz --repo tsudev-org/sound-db</code></pre>
    <p>Trên Windows PowerShell:</p>
    <pre tabindex="0" aria-label="Lệnh kiểm SHA-256 trên Windows"><code>Get-FileHash .\sound-db_{PHIEN_BAN}_x64-windows.zip -Algorithm SHA256</code></pre>
  </div>
</Trang>
