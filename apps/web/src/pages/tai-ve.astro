---
import Trang from '../layouts/Trang.astro';
import goi from '../../../../packaging/package.json';
import { PHIEN_BAN, REPO_URL } from '../lib/site';

// Lệnh cài sinh từ packaging/package.json (PACKAGING.md mục 3): chỉ kênh đã có gói thật ("channels").
const LENH: Record<string, { ten: string; lenh: string }> = {
  scoop: { ten: 'Windows - Scoop', lenh: `scoop bucket add tsudev https://github.com/tsudev-org/scoop-bucket\nscoop install tsudev/${goi.name}` },
  brew: { ten: 'macOS - Homebrew', lenh: `brew install tsudev-org/tap/${goi.name}` },
};
// apt/dnf: đọc https://pkg.tsudev.com/catalog.json LÚC BUILD (README linux-packages) - chỉ hiện khi gói có thật
// trong kho; không tải được thì bỏ khối Linux chứ không làm hỏng bản dựng.
type GoiKho = { name: string; install?: { apt?: string; dnf?: string } };
type Kho = { schema: number; setup?: { apt?: string[]; dnf?: string[] }; packages?: GoiKho[] };
let kho: Kho | undefined;
if (goi.channels.some((k) => k === 'apt' || k === 'rpm')) {
  try {
    const r = await fetch('https://pkg.tsudev.com/catalog.json', { signal: AbortSignal.timeout(15000) });
    if (r.ok) kho = (await r.json()) as Kho;
  } catch (e) {
    console.warn('[tai-ve] không đọc được catalog.json:', e);
  }
}
const goiKho = kho?.schema === 1 ? kho.packages?.find((p) => p.name === goi.name) : undefined;
if (goiKho?.install?.apt && kho?.setup?.apt) {
  LENH.apt = { ten: 'Debian, Ubuntu - APT', lenh: [...kho.setup.apt, goiKho.install.apt].join('\n') };
}
if (goiKho?.install?.dnf && kho?.setup?.dnf) {
  LENH.rpm = { ten: 'Fedora, RHEL - DNF', lenh: [...kho.setup.dnf, goiKho.install.dnf].join('\n') };
}
const kenh = goi.channels.filter((k) => k in LENH).map((k) => LENH[k]!);

const nenTang = [
  ['Windows', 'Windows 10/11 x64', 'Tệp .zip, giải nén rồi chạy sound_db.exe'],
  ['macOS', 'macOS 12 trở lên (Intel và Apple Silicon)', 'Tệp .zip chứa Sound Db.app (chưa ký Apple: chuột phải > Mở)'],
  ['Linux', 'x64 (Debian 12, Ubuntu 22.04, Fedora trở lên)', 'Gói APT/DNF (mục Cài bằng lệnh) hoặc tệp .tar.gz'],
  ['Android', 'Android 7.0 trở lên (arm64 và x86_64)', 'Tệp .apk ký số trên trang phát hành (cho phép cài từ nguồn ngoài)'],
  ['iOS và iPadOS', 'iOS 15 trở lên', 'App Store - đang chuẩn bị'],
];
---
<Trang tieuDe="Tải về" moTa="Tải Sound Db cho Android, iOS, Windows, macOS và Linux. Mỗi tệp cài đều công bố SHA-256 để bạn tự kiểm chứng trước khi cài đặt." duongDan="/tai-ve/">
  <div class="khung van-ban">
    <h1>Tải về Sound Db</h1>
    <p>Bản mới nhất: <strong>{PHIEN_BAN}</strong>. Mọi bản được dựng tự động trên GitHub Actions từ mã nguồn công khai,
      kèm SHA-256 và chứng thực nguồn gốc. Không muốn cài đặt? <a href="/do/">Đo ngay trên trình duyệt</a>.</p>
    <table class="bang">
      <thead><tr><th scope="col">Nền tảng</th><th scope="col">Yêu cầu</th><th scope="col">Kênh</th></tr></thead>
      <tbody>{nenTang.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody>
    </table>
    <p><a class="nut nut--chinh" href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer">Mở trang phát hành</a></p>
    <h2>Cài bằng lệnh</h2>
    {kenh.map((k) => (
      <>
        <p>{k.ten}:</p>
        <pre tabindex="0" aria-label={`Lệnh cài ${k.ten}`}><code>{k.lenh}</code></pre>
      </>
    ))}
    <p>Gói tự cập nhật theo bản phát hành mới (mã băm SHA-256 lấy từ chính bản phát hành).</p>

    <h2>Kiểm chứng tệp tải về</h2>
    <p>Mỗi bản phát hành kèm tệp <code>SHA256SUMS</code>. So khớp trước khi cài:</p>
    <pre tabindex="0" aria-label="Lệnh kiểm chứng tệp tải về"><code>sha256sum -c SHA256SUMS --ignore-missing
gh attestation verify sound-db_{PHIEN_BAN}_x64-linux.tar.gz --repo tsudev-org/sound-db</code></pre>
    <p>Trên Windows PowerShell:</p>
    <pre tabindex="0" aria-label="Lệnh kiểm SHA-256 trên Windows"><code>Get-FileHash .\sound-db_{PHIEN_BAN}_x64-windows.zip -Algorithm SHA256</code></pre>
  </div>
</Trang>
