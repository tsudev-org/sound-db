---
import Trang from '../layouts/Trang.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const v = t(lang).do;
---
<Trang lang={lang} tieuDe={v.tieuDe} moTa={v.moTa} duongDan="/do/">
  <div class="khung may-do">
    <h1 class="an-di">{v.h1}</h1>
    <p id="loi" class="thong-bao thong-bao--loi" role="alert" hidden></p>
    <p class="thong-bao" set:html={v.canhBao} />
    <div class="hang-nut">
      <button id="nut-do" class="nut nut--chinh" type="button">{v.batDau}</button>
      <button id="nut-dat-lai" class="nut nut--phu" type="button" disabled>{v.datLai}</button>
    </div>
    <div class="so-lon" aria-live="polite">
      <span id="nhan-muc">LAF</span>
      <output id="muc" for="nut-do">-</output>
      <span id="don-vi">dB(A)</span>
    </div>
    <div class="hang-chon">
      <div class="chon" role="group" aria-label={v.trongSoTanSo}>
        <button type="button" data-trong-so="0" aria-pressed="true">A</button>
        <button type="button" data-trong-so="1" aria-pressed="false">C</button>
        <button type="button" data-trong-so="2" aria-pressed="false">Z</button>
      </div>
      <div class="chon" role="group" aria-label={v.trongSoThoiGian}>
        {v.thoiGian.map((ten, i) => <button type="button" data-thoi-gian={String(i)} aria-pressed={i === 0 ? 'true' : 'false'}>{ten}</button>)}
      </div>
    </div>
    <dl class="o-so">
      <div><dt>Leq</dt><dd id="leq">-</dd></div>
      <div><dt>Lmax</dt><dd id="lmax">-</dd></div>
      <div><dt>Lmin</dt><dd id="lmin">-</dd></div>
      <div><dt>Lpeak</dt><dd id="lpeak">-</dd></div>
      <div><dt>LAF10</dt><dd id="l10">-</dd></div>
      <div><dt>LAF90</dt><dd id="l90">-</dd></div>
      <div><dt>{v.tanSoTroi}</dt><dd id="tan-so">-</dd></div>
      <div><dt>{v.thoiLuong}</dt><dd id="thoi-luong">-</dd></div>
    </dl>
    <canvas id="pho" class="bieu-do" role="img" aria-label={v.pho}></canvas>
    <details>
      <summary>{v.hieuChuan}</summary>
      <p set:html={v.offsetHien} />
      <label for="offset">{v.offsetMoi}</label>
      <input id="offset" class="o-tim" type="number" step="0.1" min="0" max="200" inputmode="decimal">
      <button id="nut-offset" class="nut nut--phu nut--nho" type="button">{v.apDung}</button>
    </details>
  </div>
  <script src="../scripts/may-do.ts"></script>
</Trang>
